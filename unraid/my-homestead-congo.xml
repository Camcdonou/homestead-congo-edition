<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>homestead-congo</Name>
  <Repository>itzg/minecraft-server:java17</Repository>
  <Registry>https://hub.docker.com/r/itzg/minecraft-server/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Camcdonou/homestead-congo-edition/issues</Support>
  <Project>https://github.com/Camcdonou/homestead-congo-edition</Project>
  <Overview>Homestead Congo Edition; Homestead 2.0.1 by Tokimi with Origins 1.10.2. Separate server with automatic packwiz updates on restart.</Overview>
  <DateInstalled>1791943226</DateInstalled>
  <Description>Homestead 2.0.1 with Origins for Minecraft 1.20.1 Fabric. Connect to this host on TCP port 25555.</Description>
  <WebUI/>
  <TemplateURL>https://raw.githubusercontent.com/Camcdonou/homestead-congo-edition/main/unraid/my-homestead-congo.xml</TemplateURL>
  <Icon/>
  <ExtraParams>--memory=10g</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <CPUShares/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Minecraft port" Target="25565" Default="25555" Mode="tcp" Description="Host TCP Minecraft listener on port 25555; distinct from the existing server on 25565." Type="Port" Display="always" Required="true" Mask="false">25565</Config>
  <Config Name="Voice chat port" Target="24454" Default="25555" Mode="udp" Description="Host UDP voice chat port; does not interfere with the existing server on UDP 24454." Type="Port" Display="always" Required="false" Mask="false">24454</Config>
  <Config Name="Server data" Target="/data" Default="/mnt/user/appdata/homestead-congo" Mode="rw" Description="Separate data volume for Congo Edition." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/homestead-congo</Config>
  <Config Name="EULA" Target="EULA" Default="TRUE" Mode="" Description="Accept the Minecraft EULA." Type="Variable" Display="always" Required="true" Mask="false">TRUE</Config>
  <Config Name="Loader" Target="TYPE" Default="FABRIC" Mode="" Description="Minecraft server type." Type="Variable" Display="always" Required="true" Mask="false">FABRIC</Config>
  <Config Name="Minecraft version" Target="VERSION" Default="1.20.1" Mode="" Description="Pinned Minecraft version." Type="Variable" Display="always" Required="true" Mask="false">1.20.1</Config>
  <Config Name="Fabric version" Target="FABRIC_LOADER_VERSION" Default="0.19.5" Mode="" Description="Pinned Fabric loader version." Type="Variable" Display="always" Required="true" Mask="false">0.19.5</Config>
  <Config Name="Initial memory" Target="INIT_MEMORY" Default="6G" Mode="" Description="Initial Java heap." Type="Variable" Display="always" Required="true" Mask="false">6G</Config>
  <Config Name="Maximum memory" Target="MAX_MEMORY" Default="8G" Mode="" Description="Maximum Java heap; container limit is 10 GB." Type="Variable" Display="always" Required="true" Mask="false">8G</Config>
  <Config Name="Time zone" Target="TZ" Default="America/New_York" Mode="" Description="Server time zone." Type="Variable" Display="advanced" Required="false" Mask="false">America/New_York</Config>
</Container>
